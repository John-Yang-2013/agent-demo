OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3.5
# Thinking models: keep true (separates reasoning from the answer).
# Non-thinking models (llama3…): set false.
MODEL_REASONING=true
TEMPERATURE=0.1
MAX_ITERATIONS=15

# Stage 2 — conversation memory / tool caches / model limits (all optional)
HISTORY_MAX_MESSAGES=12
WEATHER_CACHE_TTL=600
WIKIPEDIA_CACHE_TTL=3600
SEARCH_CACHE_TTL=300

# --- File sandbox (stage 3) ---
SANDBOX_ENABLED=true
SANDBOX_DIR=workspace
SANDBOX_CONFIRM=true
SANDBOX_MAX_READ_CHARS=8000
NUM_CTX=8192
NUM_PREDICT=4096

# Stage 2 — streaming & LLM-layer retry
STREAM_TOKENS=true
LLM_RETRIES=2
LLM_RETRY_DELAY=1.0
